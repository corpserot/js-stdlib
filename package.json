{
  "name": "@a.corp.serot/stdlib",
  "version": "0.1.0",
  "description": "My personal library for common/simple solutions built on top of standard JS built-ins + library",
  "author": "a.corp.serot",
  "keywords": [],
  "license": "0BSD",
  "homepage": "https://github.com/corpserot/js-stdlib",
  "bugs": "https://github.com/corpserot/js-stdlib/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corpserot/js-stdlib.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "imports": {
    "#*/": "./dist/*/index.js",
    "#*": "./dist/*.js"
  },
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "build": "tsc -p tsconfig.build.json",
    "build:check": "npm run lint && npm run test && npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:watch": "node --watch --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run format && npm run build:check"
  },
  "engines": {
    "node": ">=24.20.0 <27.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
